{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "management-system-local",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-07-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "APP_DB",
			"migrations_dir": "./db/migrations"
		}
	],
	"vars": {
		"ENVIRONMENT": "development",
		"APP_NAME": "Management System",
		"DEV_USER_EMAIL": "admin@example.com",
		"DEV_ACCESS_ROLE": "owner",
		"DEV_ACCESS_PUBLIC": "false",
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD_BASE": "",
		"ACCESS_AUD_ADMIN": "",
		"ACCESS_AUD_OWNER": "",
		"ACCESS_ACCOUNT_ID": "",
		"ACCESS_GROUP_OWNER_ID": "",
		"ACCESS_GROUP_ADMIN_ID": "",
		"ACCESS_GROUP_MEMBER_ID": "",
		"ACCESS_BOOTSTRAP_OWNER_EMAIL": ""
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
